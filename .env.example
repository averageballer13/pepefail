# ====================================================================
# pepe.fail — serverless backend environment variables
#
# Copy this file to .env for local development (vercel dev) and set the
# same variables in the Vercel project settings for deployment.
# NEVER commit a real .env file: it contains the house wallet secret.
#
# Real mode stays INACTIVE until SESSION_SECRET and HOUSE_WALLET_SECRET
# are set. Without them the site keeps working in demo mode.
# ====================================================================

# Solana cluster: "devnet" or "mainnet-beta". Defaults to devnet.
NETWORK=devnet

# JSON-RPC endpoint. Defaults to https://api.devnet.solana.com on devnet
# and https://api.mainnet-beta.solana.com on mainnet-beta. Use a paid RPC
# provider in production: public endpoints rate-limit aggressively.
#RPC_URL=https://api.devnet.solana.com

# Random string used to sign session tokens (HMAC-SHA256).
# Required for real mode. Generate with for instance:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#SESSION_SECRET=

# House wallet secret key: 64 bytes encoded in base58. It signs withdrawal
# transactions, so it controls the house funds. Required for real mode.
# Generate a fresh pair with: node tools/gen-wallet.mjs
#HOUSE_WALLET_SECRET=

# Public deposit address (base58 pubkey). Defaults to the address derived
# from HOUSE_WALLET_SECRET, so only set this if deposits should land in a
# different (e.g. cold) wallet than the one paying withdrawals.
#VAULT_ADDRESS=

# Upstash Redis REST credentials. Optional but strongly recommended:
# without them the database is an in-process memory Map, which only works
# for local development (serverless instances do not share memory).
#UPSTASH_REDIS_REST_URL=
#UPSTASH_REDIS_REST_TOKEN=

# SPL token mint of $FAIL. Optional: setting it enables the "fail" asset
# (6 decimals raw units) in /api/config.
#FAIL_MINT=

# Betting limits, always integers in lamports (1 SOL = 1e9 lamports).
# Defaults: 0.5 SOL max bet, 5 SOL max payout, 0.01 SOL min withdrawal.
#MAX_BET_LAMPORTS=500000000
#MAX_PAYOUT_LAMPORTS=5000000000
#MIN_WITHDRAW_LAMPORTS=10000000
